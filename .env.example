# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:ABC-DEF...

# Необязательно: явный Telegram ID владельца.
# Если не задан — владельцем считается тот, кто подключил бота к своему Business.
# OWNER_ID=123456789

# Путь к файлу базы данных SQLite
DB_PATH=messages.db

# Уведомлять ли о сообщениях, которые владелец удалил сам (true/false)
NOTIFY_OWN_DELETIONS=true

# Сколько МБ медиа максимум встраивать в один HTML-экспорт (0–35).
# Больше — в экспорт попадёт больше фото/видео/голосовых, но тяжелее файл.
# Потолок 35: с учётом base64 итог ≈47 МБ, под лимит отправки ботом (50 МБ).
EXPORT_MEDIA_MB=25

# Автоматически очищать базу после КАЖДОГО обычного экспорта (true/false).
# По умолчанию false — для очистки есть отдельная кнопка «🧹 Экспорт и очистка».
PURGE_AFTER_EXPORT=false

# Авто-выгрузка: когда файл базы подойдёт к этому размеру в МБ, бот сам
# пришлёт экспорт и очистит базу (чистит только при полной выгрузке).
# 0 — выключено. Пример: 100 — срабатывать около 90 МБ.
AUTO_EXPORT_MB=0
# Как часто (сек) проверять размер базы (минимум 30).
AUTO_EXPORT_CHECK_SEC=300

# Со скольких удалённых за раз сообщений это считается удалением ВСЕЙ
# переписки (одно сводное уведомление «удалена вся переписка» вместо потока).
# Минимум 2. Меньше — чаще будет срабатывать «вся переписка».
BULK_DELETE_THRESHOLD=5

# Необязательно: ID канала/группы-архива, куда дублировать удалённые и
# изменённые сообщения. Добавьте бота в этот чат (в канал — админом).
# Узнать ID можно через @userinfobot или @getidsbot (для каналов начинается с -100).
# ARCHIVE_CHAT_ID=-1001234567890

# --- Платный доступ (Platesh: оплата Telegram Stars и CryptoBot) -----------
# Если не задано — бот бесплатный для всех, как раньше.
# Platesh должен работать на этом же сервере; ключ и имя бота — из его настроек:
#   PLATESH_KEY  = значение BOT1_API_KEY из /opt/platesh/.env
#   PLATESH_BOT  = name бота в /opt/platesh/config.yaml (мастер называет его по @username)
# PLATESH_URL=http://127.0.0.1:8080
# PLATESH_KEY=
# PLATESH_BOT=
# PLATESH_ADMINS=123456789          # кто пользуется без оплаты (через запятую)
# PLATESH_PRODUCTS=premium          # какие товары открывают бота (по умолчанию — любой)
# PAYSUPPORT_TEXT=По вопросам оплаты пишите @your_support

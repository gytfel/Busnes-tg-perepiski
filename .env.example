# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:ABC-DEF...

# Необязательно: явный Telegram ID владельца.
# Если не задан — владельцем считается тот, кто подключил бота к своему Business.
# OWNER_ID=123456789

# Путь к файлу базы данных SQLite
DB_PATH=messages.db

# Уведомлять ли о сообщениях, которые владелец удалил сам (true/false)
NOTIFY_OWN_DELETIONS=true

# Необязательно: ID канала/группы-архива, куда дублировать удалённые и
# изменённые сообщения. Добавьте бота в этот чат (в канал — админом).
# Узнать ID можно через @userinfobot или @getidsbot (для каналов начинается с -100).
# ARCHIVE_CHAT_ID=-1001234567890
